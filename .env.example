# ============================================================
# TELEGRAM
# ============================================================

BOT_TOKEN=your_telegram_bot_token


# ============================================================
# SERVER
# ============================================================

PORT=8080


# ============================================================
# DOWNLOAD SETTINGS
# ============================================================

DOWNLOAD_DIR=/app/downloads

# Output format
# mp3 = maximum compatibility with Telegram
AUDIO_OUTPUT=mp3

# MP3 quality
# 320 = highest MP3 bitrate
AUDIO_QUALITY=320


# ============================================================
# LIMITS
# ============================================================

# Approximate Telegram upload limit
MAX_FILE_SIZE_MB=49

# Maximum audio/video duration in seconds
# 7200 = 2 hours
MAX_DURATION=7200


# ============================================================
# PERFORMANCE
# ============================================================

# Maximum simultaneous downloads
MAX_CONCURRENT_DOWNLOADS=2

# Maximum time allowed for one download
DOWNLOAD_TIMEOUT=600

# yt-dlp retry count
DOWNLOAD_RETRIES=3